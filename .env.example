# FairSplit demo configuration
# DEMO_MODE=true flips all external calls to safe local mocks.
DEMO_MODE=true

# Optional: real AI scoring. Without a key, a deterministic demo engine is used.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional: real PayPal sandbox payouts. Without these, payouts are simulated.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
